# Copy to .env and adjust. Every setting can also be passed as an environment variable.
BANKQ_ENV=dev
BANKQ_LOG_LEVEL=INFO
BANKQ_LOG_JSON=true
# SQLite by default; for Postgres: postgresql+psycopg://user:pass@host:5432/bankq
BANKQ_DATABASE_URL=sqlite:///data/bankq.db
# Comma-separated API keys. Leave empty ONLY for local development.
BANKQ_API_KEYS=
BANKQ_RATE_LIMIT_PER_MINUTE=120
BANKQ_MAX_BATCH_SIZE=1000
